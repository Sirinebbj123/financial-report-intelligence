# Copier ce fichier en .env et renseigner les valeurs. Ne jamais commiter .env.

# Fournisseur LLM : openai | groq | mistral | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chemins
DATA_DIR=data
INDEX_DIR=data/index

# Retrieval
TOP_K=8
